        {
          "name": "Crea hackathon",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Hackathon creato (201) o gia esistente (409)', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([201, 409]);",
                  "});",
                  "if (pm.response.code === 201) {",
                  "    var json = pm.response.json();",
                  "    pm.collectionVariables.set('hackathonNome', json.id);",
                  "    console.log('hackathonNome =', json.id);",
                  "}"
                ]
