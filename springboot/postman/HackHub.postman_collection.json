          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"{{hackathonNome}}\",\n  \"dataInizio\": \"2026-07-02\",\n  \"dataFine\": \"2026-07-04\",\n  \"luogo\": \"Camerino\",\n  \"regolamento\": \"Regolamento ufficiale della gara\",\n  \"scadenzaIscrizioni\": \"2026-07-01\",\n  \"dimensioneMaxTeam\": 5,\n  \"montepremi\": 10000,\n  \"organizzatoreEmail\": \"{{organizzatoreEmail}}\",\n  \"giudiceEmail\": \"{{giudiceEmail}}\",\n  \"mentoriEmails\": [\"{{mentoreEmail}}\"]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/hackathon",
              "host": ["{{baseUrl}}"],
              "path": ["api", "hackathon"]
            },
            "description": "Crea un hackathon. Organizzatore/giudice/mentori devono esistere (404 altrimenti). Date in formato ISO (yyyy-MM-dd). 201 con id (= nome)."
          }
        },
