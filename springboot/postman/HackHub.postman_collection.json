{
  "info": {
    "name": "HackHub API",
    "description": "Collezione delle chiamate REST del backend Spring Boot di HackHub.\n\nBase URL configurabile tramite la variabile di collezione `baseUrl` (default http://localhost:8080).\n\nAvviare prima il server con `./gradlew bootRun` dalla cartella `springboot/`.\n\nGli id generati a runtime (iscrizioneId, invitoId, sottomissioneId, richiestaId, propostaId, segnalazioneId) vengono salvati automaticamente nelle variabili di collezione dagli script della tab Tests: le chiamate successive li riusano tramite {{...}}. Eseguendo le richieste nell'ordine in cui compaiono (dall'alto verso il basso, tramite il Collection Runner) il flusso funziona senza copiare id a mano.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080", "type": "string" },
    { "key": "hackathonNome", "value": "HackHub 2026", "type": "string" },
    { "key": "teamNome", "value": "Team Alpha", "type": "string" },
    {
      "key": "organizzatoreEmail",
      "value": "organizzatore@example.com",
      "type": "string"
    },
    { "key": "giudiceEmail", "value": "giudice@example.com", "type": "string" },
    { "key": "mentoreEmail", "value": "mentore@example.com", "type": "string" },
    {
      "key": "creatoreEmail",
      "value": "mario.rossi@example.com",
      "type": "string"
    },
    {
      "key": "invitatoEmail",
      "value": "collega@example.com",
      "type": "string"
    },
    { "key": "iscrizioneId", "value": "", "type": "string" },
    { "key": "invitoId", "value": "", "type": "string" },
    { "key": "sottomissioneId", "value": "", "type": "string" },
    { "key": "richiestaId", "value": "", "type": "string" },
    { "key": "propostaId", "value": "", "type": "string" },
    { "key": "segnalazioneId", "value": "", "type": "string" }
