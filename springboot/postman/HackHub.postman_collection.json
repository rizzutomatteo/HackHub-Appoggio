  "item": [
    {
      "name": "Account",
      "item": [
        {
          "name": "Registrati (UC19)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Registrazione riuscita (201) o gia esistente (409)', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([201, 409]);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Mario Rossi\",\n  \"email\": \"{{creatoreEmail}}\",\n  \"password\": \"segreta123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/account/registrati",
              "host": ["{{baseUrl}}"],
              "path": ["api", "account", "registrati"]
            },
            "description": "Registra un nuovo utente. 201 con id (= email) se creato; 409 se registrazione non riuscita.\n\nNOTA: per far funzionare 'Crea hackathon' servono anche gli utenti organizzatore, giudice e mentore: duplicare questa richiesta cambiando nome/email (o le variabili organizzatoreEmail/giudiceEmail/mentoreEmail)."
          }
        },
        {
          "name": "Accedi (UC20)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Autenticazione riuscita (200)', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{creatoreEmail}}\",\n  \"password\": \"segreta123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/account/accedi",
              "host": ["{{baseUrl}}"],
              "path": ["api", "account", "accedi"]
            },
            "description": "Autentica un utente esistente. 200 con email; 401 se credenziali non valide."
          }
        }
      ]
    },
    {
      "name": "Hackathon",
