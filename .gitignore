# Cache font di Java generata dal render PlantUML in Docker (HOME non impostata)
/[?]/
.java/

# File temporanei e di backup di Visual Paradigm (non versionare)
*.lck
*.vpp.bak*

# PlantUML jar del renderer locale (binario ~22MB, non sorgente: si riscarica)
scripts/lib/plantuml.jar

# Config IDE JetBrains / VS Code e cruft OS (locale, non versionare)
.idea/
*.iml
.vscode/
.DS_Store

# Alternate data streams NTFS creati da WSL su file scaricati/copiati da Windows
*Zone.Identifier
